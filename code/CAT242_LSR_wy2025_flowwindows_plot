# --- Code Description ---
# Developed to plot observed discharge data for the 2025 water year on Little Shasta River, 
# highlighting observed windows for fall pulse, wet season base flow, and two dry season base flow windows used in the W3T model analysis. 
# Uses data pulled from Eyasco's LSR monitoring station
# Created for CAT242, January 2025 by A. Chenette

# --- Load packages ---
library(readxl)
library(ggplot2)
library(dplyr)
library(scales)

# --- Read data ---
excel_path <- "C:/Users/AdrienneChenette/Desktop/LSR_flowdata_wy2025.xlsx"
df <- read_excel(excel_path)

# --- Inspect first few columns to confirm names ---
print(head(df))

# --- Rename columns as needed (adjust to your data) ---
df <- df |>
  rename(datetime = Date,
         discharge_cfs = 'TNC LS Host / RiverFlow / CalcFlow - cfs')

# --- Ensure datetime is in proper format ---
df$datetime <- as.POSIXct(df$datetime, tz = "UTC")

# --- Highlight windows ---
highlight1_start <- as.POSIXct("2024-11-21", tz = "UTC")
highlight1_end   <- as.POSIXct("2024-11-27", tz = "UTC")
highlight2_start <- as.POSIXct("2025-01-26", tz = "UTC")
highlight2_end   <- as.POSIXct("2025-02-01", tz = "UTC")
highlight3_start <- as.POSIXct("2025-07-31", tz = "UTC")
highlight3_end   <- as.POSIXct("2025-08-08", tz = "UTC")
highlight4_start <- as.POSIXct("2025-08-11", tz = "UTC")
highlight4_end   <- as.POSIXct("2025-08-23", tz = "UTC")

# --- Plot ---
ggplot(df, aes(x = datetime, y = discharge_cfs)) +
  # --- Base shaded area under the main hydrograph line ---
  geom_ribbon(aes(ymin = 0, ymax = discharge_cfs),
              fill = "lightblue", alpha = 0.35) +
  
  # --- Yellow highlight (Fall Pulse) ---
  geom_ribbon(data = filter(df, datetime >= highlight1_start & datetime <= highlight1_end),
              aes(ymin = 0, ymax = discharge_cfs),
              fill = "#F9A51A", alpha = 0.4) +
  
  # --- Bright pink highlight (Wet Season Baseflow used in W3T model) ---
  geom_ribbon(data = filter(df, datetime >= highlight2_start & datetime <= highlight2_end),
              aes(ymin = 0, ymax = discharge_cfs),
              fill = "deeppink", alpha = 0.45) +
  
  # --- Red-orange highlight (07/31/25-08/08/25) ---
  geom_ribbon(data = filter(df, datetime >= highlight3_start & datetime <= highlight3_end),
              aes(ymin = 0, ymax = discharge_cfs),
              fill = "#EE4023", alpha = 0.4) +
  
  # --- Red-orange highlight (08/11/25-08/23/25) ---
  geom_ribbon(data = filter(df, datetime >= highlight4_start & datetime <= highlight4_end),
              aes(ymin = 0, ymax = discharge_cfs),
              fill = "#EE4023", alpha = 0.4) +
  
  # --- Line for the main hydrograph ---
  geom_line(color = "#008DA5", size = 0.3) +
  
  # --- Yellow overlay line for Fall Pulse ---
  geom_line(data = filter(df, datetime >= highlight1_start & datetime <= highlight1_end),
            color = "#F9A51A", size = 0.4) +
  
  # --- Pink overlay line for Wet Season Baseflow ---
  geom_line(data = filter(df, datetime >= highlight2_start & datetime <= highlight2_end),
            color = "deeppink3", size = 0.4) +
  
  # --- Red-orange overlay line (07/31/25-08/08/25) ---
  geom_line(data = filter(df, datetime >= highlight3_start & datetime <= highlight3_end),
            color = "#EE4023", size = 0.4) +
  
  # --- Red-orange overlay line (08/11/25-08/23/25) ---
  geom_line(data = filter(df, datetime >= highlight4_start & datetime <= highlight4_end),
            color = "#EE4023", size = 0.4) +
  
  # --- Classic ggplot2 theme (gray background, white grid) ---
  theme_gray(base_size = 13) +
  theme(
    panel.grid.major = element_line(color = "white"),
    panel.grid.minor = element_blank(),
    axis.text = element_text(color = "black"),
    axis.title = element_text(color = "black"),
    
    # --- FONT SIZE EDIT ↓ ---
    axis.text.x = element_text(size = 14, angle = 45, hjust = 1),   # x-axis tick labels
    axis.text.y = element_text(size = 14),                          # y-axis tick labels
    axis.title.x = element_text(size = 14),          # x-axis title
    axis.title.y = element_text(size = 14),          # y-axis title
    # --- FONT SIZE EDIT ↑ ---
    
    plot.title = element_text(face = "bold", size = 15, hjust = 0.5)
  ) +
  
  # --- Labels and scales ---
  labs(
    title = "Discharge at LSR with observed flow windows highlighted",
    x = "Date",
    y = "Discharge (CFS)"
  ) +
  scale_y_continuous(
    limits = c(0, 160),               # set range
    breaks = seq(0, 160, by = 20),    # tick every 20 CFS
    labels = scales::comma,          # format with commas
    expand = expansion(mult = c(0, 0.05))
  ) +
  scale_x_datetime(
    date_labels = "%b %d",
    breaks = c(
      min(df$datetime, na.rm = TRUE),
      seq(min(df$datetime, na.rm = TRUE),
          max(df$datetime, na.rm = TRUE),
          by = "25 days"),
      max(df$datetime, na.rm = TRUE)
    ),
    expand = c(0, 0)
  )

ggsave(filename = "output/LSR_wy25_flowwindows_plot.png", dpi = 300, width = 10, height = 5, units = "in")
